<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ApksToApk" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/md_text_secondary</item>
        <item name="colorOutline">@color/md_stroke</item>
        <item name="colorError">@color/md_error</item>
        <item name="android:colorBackground">@color/md_bg</item>
        <item name="android:statusBarColor">@color/md_bg</item>
        <item name="android:navigationBarColor">@color/md_nav_bg</item>
        <item name="android:windowBackground">@color/md_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialButtonStyle">@style/Widget.MyTools.Button</item>
    </style>

    <style name="Widget.MyTools.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.MyTools.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.MyTools.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/md_stroke_strong</item>
    </style>

    <style name="Text.MyTools.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/md_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.MyTools.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/md_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.MyTools.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/md_text_secondary</item>
    </style>

    <style name="Text.MyTools.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/md_text_secondary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.MyTools.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/md_surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/md_stroke</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Widget.MyTools.Card.Interactive" parent="Widget.MyTools.Card">
        <item name="cardBackgroundColor">@color/md_surface_2</item>
        <item name="rippleColor">@color/md_nav_indicator</item>
    </style>
</resources>
